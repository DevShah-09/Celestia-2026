PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/celestia
JWT_SECRET=replace-with-a-long-random-secret
# Deployed frontend origin (no /api or trailing slash). Comma-separate multiple origins.
FRONTEND_URL=http://localhost:5173
# Omit BOTH on the deployed backend to queue QR emails for your local sender.
# Set these only in local backend/.env when running npm run emails:send.
# Local MONGODB_URI must point to the SAME production database.
# EMAIL_PASS is your Gmail app password.
EMAIL_USER=
EMAIL_PASS=

# Private administrator credentials for local account setup.
ADMIN_NAME=Celestia Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
# Only required when running bulk registration.
BULK_ADMIN_EMAIL=
BULK_ADMIN_PASSWORD=
