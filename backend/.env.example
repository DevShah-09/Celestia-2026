PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/celestia
JWT_SECRET=replace-with-a-long-random-secret
# Optional for registration email; registered teams can download their QR code.
EMAIL_USER=
EMAIL_PASS=

# Private administrator credentials for local account setup.
ADMIN_NAME=Celestia Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_ROLE=admin
# Only required when running bulk registration.
BULK_ADMIN_EMAIL=
BULK_ADMIN_PASSWORD=
